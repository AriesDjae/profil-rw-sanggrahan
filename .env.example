# PostgreSQL. Di lingkungan demo memakai Neon (neon.tech).
# Contoh: postgresql://pengguna:sandi@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://pengguna:sandi@host/nama_basis_data?sslmode=require"

# Kunci penanda tangan sesi. Wajib diganti, minimal 32 karakter.
SESSION_SECRET="ubah-ini-dengan-string-acak-minimal-32-karakter"

# Opsional. Bila diisi, unggahan disimpan ke Vercel Blob.
# Bila dikosongkan, unggahan ditulis ke folder public/unggahan.
BLOB_READ_WRITE_TOKEN=""

# Opsional. Alamat kanonik situs untuk sitemap dan pratinjau tautan.
# Dikosongkan = memakai bawaan di src/lib/situs.ts.
NEXT_PUBLIC_SITE_URL=""

# Opsional. Alamat situs Registri Usaha Warga Sanggrahan, ditautkan dari kop
# dan kaki halaman. Dikosongkan = memakai bawaan di src/lib/tautanLuar.ts.
NEXT_PUBLIC_URL_UMKM=""

# Opsional. Isi `mati` untuk menyembunyikan pita "Situs demo" di halaman publik
# setelah situs memakai data warga asli. Dikosongkan = pita tampil.
LABEL_DATA_CONTOH=""

# Opsional, khusus situs demo panel pengurus (README: "Situs demo panel pengurus").
# MODE_DEMO=nyala membuka panel tanpa kata sandi. JANGAN dipasang di situs utama.
MODE_DEMO=""
# Token titik POST /api/demo/segarkan, minimal 32 karakter. Hanya di situs demo.
RAHASIA_SEGARKAN_DEMO=""
# Di situs utama: alamat situs demo, ditautkan dari pita "Situs demo".
NEXT_PUBLIC_URL_DEMO=""
